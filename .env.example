# miamigezi — ortam değişkenleri şablonu
# Kopyala: cp .env.example .env.local   (.env.local git'e GİRMEZ)
#
# KURAL: bu dosyaya ASLA gerçek değer yazma. Burası yalnızca isim + açıklama
# kataloğu; değerler .env.local'de ve Vercel proje ayarlarında yaşar.

# ─────────────────────────────────────────────────────────────────────────
# Ölçümleme (tarayıcıya gider — gizli DEĞİL, ama boşken analytics HİÇ
# yüklenmez: kod GA'yı yalnızca (a) bu değişken doluysa ve (b) ziyaretçi
# çerez onayı verdiyse render eder.)
#
# miamili.com'dan AYRI bir GA4 property açılmalı. Aynı property'yi paylaşmak
# iki sitenin trafiğini tek raporda birleştirir ve "uydu site gerçekten
# trafik getiriyor mu" sorusunu ölçülemez hâle getirir — projenin bütün
# amacı bu ölçüm olduğu için ayrı property zorunlu.
#
# DİKKAT: NEXT_PUBLIC_* değerleri BUILD anında gömülür. Vercel'e ekledikten
# sonra yeniden deploy etmeden mevcut deployment'ta ölçümleme başlamaz.
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ─────────────────────────────────────────────────────────────────────────
# İçerik hattı (yalnızca CI + yerel üretim; tarayıcıya GİTMEZ)
#
# GitHub'da repo secret olarak tanımlanır: Settings → Secrets and variables
# → Actions → New repository secret → ANTHROPIC_API_KEY
# Bu secret eklenmeden günlük workflow her sabah kırmızı düşer (bilinçli:
# sessizce atlamak, hattın çalıştığı yanılsamasını yaratıyordu).
#
# Yerelde denemek için:  ANTHROPIC_API_KEY=... npm run blog:generate
# API'siz denemek için:  npm run blog:test  /  npm run blog:dry
# ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Opsiyonel — üretim modelini geçici olarak değiştirmek için.
# Boşsa scripts/generate-blog-post.mjs içindeki varsayılan kullanılır.
# BLOG_MODEL=
